# Prefer .env.local for local QA (gitignored via .env*.local). Or copy to .env.qa.local.
# Never commit real values.

# Mode A — one RBAC password for admin QA accounts (qa.pm, qa.schoolmgr, qa.supervisor, qa.staff)
QA_PASSWORD=your-rbac-password-here
# ODOO_QA_RBAC_PASSWORD=your-rbac-password-here

# Mode B — per-account overrides (optional; wins over QA_PASSWORD)
# QA_PM_PASSWORD=
# QA_SCHOOLMGR_PASSWORD=
# QA_SUPERVISOR_PASSWORD=
# QA_STAFF_PASSWORD=

# Portal accounts often differ on alwah (confirm via scripts/odoo-direct-auth-probe.mjs)
QA_TEACHER_PASSWORD=your-teacher-password-here
QA_PARENT_PASSWORD=your-parent-password-here
QA_STUDENT_PASSWORD=your-student-password-here

# Odoo-style aliases (optional)
# ODOO_QA_ADMIN_PASSWORD=
# ODOO_QA_TEACHER_PASSWORD=
# ODOO_QA_PARENT_PASSWORD=
# ODOO_QA_STUDENT_PASSWORD=
