# Base URL of the Odoo backend that serves the Smart School Connect API v1.
# The browser NEVER calls this directly — Next.js proxies all traffic.
ODOO_BASE_URL=http://localhost:8069

# Odoo database name used during /web/session/authenticate.
ODOO_DB=alwah

# Name of the httpOnly cookie Next.js uses to hold the Odoo session id.
# (Defaults to "scc_session" if unset.)
SESSION_COOKIE_NAME=scc_session
